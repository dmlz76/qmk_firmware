{
    "manufacturer": "dimitrix llc",
    "keyboard_name": "mini-mighty-dongle",
    "maintainer": "dmlz76",
    "bootloader": "atmel-dfu",
    "build": {
        "lto": true
    },
    "features": {
        "bootmagic": false,
        "encoder": false,
        "extrakey": true,
        "grave_esc": false,
        "magic": false,
        "mouse": true,
        "mousekey": false,
        "nkro": false,
        "os_detection": true,
        "pointing_device": false,
        "space_cadet": false
    },
    "matrix_pins": {
        "custom": true,
        "direct": [
            ["NO_PIN"]
        ]
    },
    "processor": "atmega16u2",
    "url": "dimitrix.llc",
    "usb": {
        "device_version": "1.0.0",
        "pid": "0xFFF2", // TEMP
        "vid": "0x04D8" // Microchip   
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0}
            ]
        }
    }
}
